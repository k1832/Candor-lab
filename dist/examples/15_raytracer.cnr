boundary
// A ray tracer written in pure Candor — the visual showcase. It renders four
// spheres (one a 0.85-reflectivity mirror) on a checkerboard ground plane
// under a directional sun — hard shadows, mirror bounces, a sky gradient,
// 2x2 supersampling, sqrt-gamma output — and writes the picture to
// `render.ppm` as a binary P6 PPM (640x480, 921,615 bytes) through the same
// audited open/write/close file boundary as examples/12 and /14.
//
//   RUN IT FROM THIS DIRECTORY (render.ppm lands in the process cwd):
//     cd examples
//     candor compile 15_raytracer.cnr -o rt --release && ./rt   # ~3 s, exits 42
//     # or interpreted (same bytes, no toolchain flags — but minutes, not seconds):
//     candor run 15_raytracer.cnr
//
//   VIEW THE IMAGE: P6 PPM opens directly in most viewers (GIMP, feh, eog,
//   IrfanView, macOS Preview). To convert:
//     magick render.ppm render.png        # ImageMagick
//     ffmpeg -i render.ppm render.png     # or ffmpeg
//
// WHY THIS IS A SHOWCASE: every pixel is real f64 numeric work — ray-sphere
// quadratics, normalization, Lambert shading, reflection — over the IEEE-754
// operations Candor guarantees bit-deterministic across all five engines
// (tree-walker, MIR interpreter, Cranelift no-opt/-O2, LLVM -O2), with the
// correctly-rounded `sqrt` intrinsic doing the vector lengths, shadow
// distances, and gamma curve. Same code, same scene, SAME BYTES on every
// engine: the lab pins a 64x48 twin of this render (its per-pixel checksum
// and probe pixels) across all five engines, so the picture itself is a
// differential-verification artifact. Deterministic by construction: there
// is no randomness anywhere — supersample offsets are fixed quarter-pixel
// points, shadows are hard, and the reflection walk is a bounded loop.
//
// SHAPE NOTES, stated plainly:
//   - No recursion: reflections accumulate iteratively (throughput `att`)
//     in a while loop capped at 4 bounces.
//   - No allocator: one fixed 1,920-byte row buffer, written row by row —
//     the whole render needs no heap at all.
//   - Pixel bytes narrow f64 -> i64 -> clamp -> u8. A direct float->u8
//     `conv` is avoided deliberately: f64 to a sub-32-bit integer currently
//     panics the Cranelift x64 emitter (a known toolchain bug found while
//     building this example); the i64 detour is also what the checked-
//     narrowing style wants — clamp first, then narrow.

// ---- the audited file boundary (the examples/12,/14 externs, file slice) ----

extern "C" {
    fn sys_open(path: rawptr u8, flags: i32, mode: i32) -> i32
        trust "POSIX open(2): reads a NUL-terminated path, retains no pointer, thread-confined to this call" {
            valid_nul_terminated(path),
            no_retain(path),
        };
    fn sys_close(fd: i32) -> i32
        trust "POSIX close(2): closes a descriptor; touches no Candor memory" {};
    fn sys_write(fd: i32, buf: rawptr u8, count: usize) -> isize
        trust "POSIX write(2): reads at most count bytes from buf, retains no pointer, thread-confined" {
            valid_for(buf, count),
            no_retain(buf),
            thread_confined(buf),
        };
}

pub enum IoError {
    Errno(i32),
}

pub enum IoResult {
    ok Ok(usize),
    Err(IoError),
}

pub fn stdout() -> i32 {
    return 1i32;
}

// Open for writing: O_WRONLY|O_CREAT|O_TRUNC (577) mode 0644 (420).
pub fn open_trunc(path: [u8]) -> IoResult {
    unsafe "sys_open trust discharged: path is a live NUL-terminated [u8] view; flags create-or-truncate a regular file for writing; open retains nothing (POSIX)" {
        let fd: i32 = sys_open(addr_of(path[0]), 577i32, 420i32);
        if fd < 0i32 {
            return IoResult::Err(IoError::Errno(fd));
        }
        return IoResult::Ok(conv usize fd);
    }
}

pub fn close(fd: i32) -> IoResult {
    unsafe "sys_close trust discharged: fd is a descriptor; close touches no Candor memory" {
        let r: i32 = sys_close(fd);
        if r < 0i32 {
            return IoResult::Err(IoError::Errno(r));
        }
        return IoResult::Ok(0usize);
    }
}

pub fn write_all(fd: i32, s: [u8]) -> IoResult {
    let total: usize = len(s);
    if total == 0usize {
        return IoResult::Ok(0usize);
    }
    unsafe "sys_write trust discharged: s is a live [u8] view valid for len(s) bytes; write retains nothing (POSIX), thread-confined" {
        let n: isize = sys_write(fd, addr_of(s[0]), total);
        if n < 0isize {
            return IoResult::Err(IoError::Errno(conv i32 n));
        }
        if conv usize n < total {
            return IoResult::Err(IoError::Errno(0i32 - 1i32));
        }
        return IoResult::Ok(total);
    }
}

// One static line + newline to stdout (no allocation).
fn log_line(msg: str) -> unit {
    let w1: IoResult = write_all(stdout(), as_bytes(msg));
    let nl: [1]u8 = [10u8; 1];
    let w2: IoResult = write_all(stdout(), slice_of(nl));
}

// ---- the tracer core (byte-identical twin: the lab run-corpus raytracer) ----

copy struct V3 {
    x: f64,
    y: f64,
    z: f64,
}

fn v3(x: f64, y: f64, z: f64) -> V3 {
    return V3 { x: x, y: y, z: z };
}

fn vadd(a: V3, b: V3) -> V3 {
    return V3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z };
}

fn vsub(a: V3, b: V3) -> V3 {
    return V3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z };
}

fn vscale(a: V3, s: f64) -> V3 {
    return V3 { x: a.x * s, y: a.y * s, z: a.z * s };
}

fn vdot(a: V3, b: V3) -> f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

fn vnorm(a: V3) -> V3 {
    let inv: f64 = 1.0 / sqrt(vdot(a, a));
    return vscale(a, inv);
}

fn vreflect(d: V3, n: V3) -> V3 {
    return vsub(d, vscale(n, 2.0 * vdot(d, n)));
}

copy struct Sphere {
    c: V3,
    r: f64,
    col: V3,
    refl: f64,
}

copy struct Hit {
    t: f64,
    obj: i64,
}

fn scene() -> [4]Sphere {
    let mirror: Sphere = Sphere { c: v3(0.0, 1.0, 3.4), r: 1.0, col: v3(0.95, 0.95, 0.95), refl: 0.85 };
    let red: Sphere = Sphere { c: v3(-1.9, 0.62, 2.4), r: 0.62, col: v3(0.85, 0.22, 0.18), refl: 0.05 };
    let gold: Sphere = Sphere { c: v3(1.75, 0.55, 2.2), r: 0.55, col: v3(0.88, 0.58, 0.16), refl: 0.3 };
    let blue: Sphere = Sphere { c: v3(-0.55, 0.3, 1.5), r: 0.3, col: v3(0.25, 0.4, 0.9), refl: 0.15 };
    let s: [4]Sphere = [mirror, red, gold, blue];
    return s;
}

fn sphere_hit(o: V3, d: V3, s: Sphere) -> f64 {
    let oc: V3 = vsub(o, s.c);
    let b: f64 = vdot(oc, d);
    let cq: f64 = vdot(oc, oc) - s.r * s.r;
    let disc: f64 = b * b - cq;
    if disc < 0.0 {
        return -1.0;
    }
    let sq: f64 = sqrt(disc);
    let mut t: f64 = -b - sq;
    if t < 0.001 {
        t = -b + sq;
    }
    if t < 0.001 {
        return -1.0;
    }
    return t;
}

fn hit_scene(o: V3, d: V3, s: read [4]Sphere) -> Hit {
    let mut best: f64 = 1.0e30;
    let mut obj: i64 = 0 - 1;
    let mut i: usize = 0usize;
    while i < 4usize {
        let t: f64 = sphere_hit(o, d, s[i]);
        if t > 0.0 && t < best {
            best = t;
            obj = conv i64 i;
        }
        i = i + 1usize;
    }
    if d.y < -0.0001 {
        let tp: f64 = -o.y / d.y;
        if tp > 0.001 && tp < best {
            best = tp;
            obj = 4;
        }
    }
    return Hit { t: best, obj: obj };
}

fn floor_i(x: f64) -> i64 {
    let mut f: i64 = conv i64 x;
    if conv f64 f > x {
        f = f - 1;
    }
    return f;
}

fn sky(d: V3) -> V3 {
    let t: f64 = 0.5 * (d.y + 1.0);
    let white: V3 = v3(1.0, 1.0, 1.0);
    let blue: V3 = v3(0.45, 0.62, 0.95);
    return vadd(vscale(white, 1.0 - t), vscale(blue, t));
}

// Directional sun: the unit vector TOWARD the light (up, left, slightly front).
fn light_dir() -> V3 {
    return vnorm(v3(-1.1, 1.0, -0.4));
}

fn trace_ray(o0: V3, d0: V3, s: read [4]Sphere) -> V3 {
    let mut o: V3 = o0;
    let mut d: V3 = d0;
    let mut acc: V3 = v3(0.0, 0.0, 0.0);
    let mut att: f64 = 1.0;
    let mut depth: i64 = 0;
    while depth < 4 {
        let h: Hit = hit_scene(o, d, s);
        if h.obj < 0 {
            acc = vadd(acc, vscale(sky(d), att));
            return acc;
        }
        let p: V3 = vadd(o, vscale(d, h.t));
        let mut n: V3 = v3(0.0, 1.0, 0.0);
        let mut albedo: V3 = v3(0.0, 0.0, 0.0);
        let mut refl: f64 = 0.0;
        if h.obj < 4 {
            let sp: Sphere = s[conv usize h.obj];
            n = vscale(vsub(p, sp.c), 1.0 / sp.r);
            albedo = sp.col;
            refl = sp.refl;
        } else {
            let par: i64 = floor_i(p.x) + floor_i(p.z);
            if par - par / 2 * 2 == 0 {
                albedo = v3(0.85, 0.85, 0.85);
            } else {
                albedo = v3(0.22, 0.26, 0.32);
            }
            refl = 0.07;
        }
        let ldir: V3 = light_dir();
        let mut diff: f64 = vdot(n, ldir);
        if diff < 0.0 {
            diff = 0.0;
        }
        let so: V3 = vadd(p, vscale(n, 0.001));
        let sh: Hit = hit_scene(so, ldir, s);
        if sh.obj >= 0 {
            diff = 0.0;
        }
        let lum: f64 = 0.09 + 1.0 * diff;
        let local: V3 = vscale(albedo, lum);
        acc = vadd(acc, vscale(local, att * (1.0 - refl)));
        if refl <= 0.0 {
            return acc;
        }
        att = att * refl;
        d = vnorm(vreflect(d, n));
        o = vadd(p, vscale(n, 0.001));
        depth = depth + 1;
    }
    return acc;
}

fn to_byte(c: f64) -> i64 {
    let mut g: f64 = c;
    if g < 0.0 {
        g = 0.0;
    }
    if g > 1.0 {
        g = 1.0;
    }
    g = sqrt(g);
    let mut b: i64 = conv i64 (g * 255.0 + 0.5);
    if b < 0 {
        b = 0;
    }
    if b > 255 {
        b = 255;
    }
    return b;
}

fn render_pixel(px: i64, py: i64, w: i64, h: i64, s: read [4]Sphere) -> V3 {
    let cam: V3 = v3(0.0, 1.1, -2.4);
    let aspect: f64 = conv f64 w / conv f64 h;
    let fov: f64 = 0.62;
    let mut col: V3 = v3(0.0, 0.0, 0.0);
    let mut sy: i64 = 0;
    while sy < 2 {
        let mut sx: i64 = 0;
        while sx < 2 {
            let ox: f64 = 0.25 + 0.5 * conv f64 sx;
            let oy: f64 = 0.25 + 0.5 * conv f64 sy;
            let u: f64 = (2.0 * (conv f64 px + ox) / conv f64 w - 1.0) * aspect * fov;
            let v: f64 = (1.0 - 2.0 * (conv f64 py + oy) / conv f64 h) * fov;
            let d: V3 = vnorm(v3(u, v, 1.0));
            col = vadd(col, trace_ray(cam, d, s));
            sx = sx + 1;
        }
        sy = sy + 1;
    }
    return vscale(col, 0.25);
}

// ---- PPM (P6) emit ----------------------------------------------------------

// Write the decimal digits of `v` into `buf` at `at`; returns the next offset.
fn emit_dec(buf: write [u8], at: usize, v: i64) -> usize {
    let mut digits: [8]u8 = [0u8; 8];
    let mut n: i64 = v;
    let mut k: usize = 0usize;
    if n == 0 {
        digits[0] = 48u8;
        k = 1usize;
    }
    while n > 0 {
        let d: i64 = n - n / 10 * 10;
        digits[k] = conv u8 (48 + d);
        n = n / 10;
        k = k + 1usize;
    }
    let mut i: usize = 0usize;
    let mut pos: usize = at;
    while i < k {
        buf[pos] = digits[k - 1usize - i];
        pos = pos + 1usize;
        i = i + 1usize;
    }
    return pos;
}

fn main() -> i64 {
    let s: [4]Sphere = scene();
    let w: i64 = 640;
    let h: i64 = 480;

    // "render.ppm\0" — the NUL-terminated path the open(2) trust needs.
    let name: [11]u8 = [114u8, 101u8, 110u8, 100u8, 101u8, 114u8, 46u8, 112u8, 112u8, 109u8, 0u8];
    let fd: i64 = match open_trunc(slice_of(name)) {
        IoResult::Ok(f) => conv i64 f,
        IoResult::Err(e) => 0 - 1,
    };
    if fd < 0 {
        log_line("raytracer: cannot open render.ppm");
        return 1;
    }

    // Header: "P6\n640 480\n255\n".
    let mut hdr: [32]u8 = [0u8; 32];
    hdr[0] = 80u8;
    hdr[1] = 54u8;
    hdr[2] = 10u8;
    let mut at: usize = emit_dec(slice_of_mut(hdr), 3usize, w);
    hdr[at] = 32u8;
    at = emit_dec(slice_of_mut(hdr), at + 1usize, h);
    hdr[at] = 10u8;
    at = emit_dec(slice_of_mut(hdr), at + 1usize, 255);
    hdr[at] = 10u8;
    at = at + 1usize;
    let wh: IoResult = write_all(conv i32 fd, subslice(slice_of(hdr), 0usize, at));

    // Render top to bottom, one 640-pixel row (1,920 bytes) at a time.
    let mut row: [1920]u8 = [0u8; 1920];
    let mut py: i64 = 0;
    while py < h {
        let mut px: i64 = 0;
        while px < w {
            let c: V3 = render_pixel(px, py, w, h, read s);
            let base: usize = conv usize (px * 3);
            row[base] = conv u8 to_byte(c.x);
            row[base + 1usize] = conv u8 to_byte(c.y);
            row[base + 2usize] = conv u8 to_byte(c.z);
            px = px + 1;
        }
        let wr: IoResult = write_all(conv i32 fd, slice_of(row));
        py = py + 1;
    }
    let cc: IoResult = close(conv i32 fd);
    log_line("raytracer: wrote render.ppm (640x480, P6)");
    return 42;
}
