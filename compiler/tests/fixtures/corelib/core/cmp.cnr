// core layer: an `Ord` comparison interface impl'd for the builtin scalar types,
// with the generic consumers (`min`/`max`/`sort_ord`) built on it, plus a
// comparator-driven `sort`. `Ord` is impl'd for `i64`/`u8`/`usize`/`u32` in the
// interface's own module — the scalar orphan rule (design 0007 §2.3): a scalar
// has no home module, so its impls live where the interface is defined.
//
// `min`/`max` are non-`alloc` (`T: copy` keeps the scanned elements drop-inert);
// `sort_ord`/`sort` are `alloc`-marked because they rebuild a `Vec[T]` in place.
use core::opt::{Opt};

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

pub interface Ord {
    fn cmp(read self, other: Self) -> Ordering;
}

impl Ord for i64 {
    fn cmp(read self, other: Self) -> Ordering {
        if self.* < other {
            return Ordering::Less;
        }
        if self.* > other {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

impl Ord for u8 {
    fn cmp(read self, other: Self) -> Ordering {
        if self.* < other {
            return Ordering::Less;
        }
        if self.* > other {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

impl Ord for usize {
    fn cmp(read self, other: Self) -> Ordering {
        if self.* < other {
            return Ordering::Less;
        }
        if self.* > other {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

impl Ord for u32 {
    fn cmp(read self, other: Self) -> Ordering {
        if self.* < other {
            return Ordering::Less;
        }
        if self.* > other {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

pub fn min[T: Ord + copy](v: read Vec[T]) -> Opt[T] {
    let n: usize = len(read v.*);
    if n == 0usize {
        return Opt::None;
    }
    let mut best: T = get(read v.*, 0usize).*;
    let mut i: usize = 1usize;
    while i < n {
        let cur: T = get(read v.*, i).*;
        match cur.cmp(best) {
            Ordering::Less => {
                best = cur;
            },
            Ordering::Equal => {},
            Ordering::Greater => {},
        }
        i = i + 1usize;
    }
    return Opt::Some(best);
}

pub fn max[T: Ord + copy](v: read Vec[T]) -> Opt[T] {
    let n: usize = len(read v.*);
    if n == 0usize {
        return Opt::None;
    }
    let mut best: T = get(read v.*, 0usize).*;
    let mut i: usize = 1usize;
    while i < n {
        let cur: T = get(read v.*, i).*;
        match cur.cmp(best) {
            Ordering::Greater => {
                best = cur;
            },
            Ordering::Less => {},
            Ordering::Equal => {},
        }
        i = i + 1usize;
    }
    return Opt::Some(best);
}

// Both sorts are in-place bottom-up heapsorts: O(n log n) worst case with no
// scratch buffer. The signatures carry no allocator handle and a `Vec` does not
// expose its own, so the algorithm must work entirely inside the given `Vec`.
//
// `sift_down_ord` restores the max-heap property (under `Ord::cmp`) for the
// subtree rooted at `root`; `end` is one past the last heap slot.
fn sift_down_ord[T: Ord + copy](v: write Vec[T], root: usize, end: usize) alloc -> unit {
    let mut i: usize = root;
    // `i` has a left child iff `i < end / 2`; the guard also keeps the child
    // index math (at most `end`) inside checked-arithmetic bounds.
    while i < end / 2usize {
        let left: usize = 2usize * i + 1usize;
        let mut child: usize = left;
        if left + 1usize < end {
            let l: T = get(read v.*, left).*;
            let r: T = get(read v.*, left + 1usize).*;
            match l.cmp(r) {
                Ordering::Less => {
                    child = left + 1usize;
                },
                Ordering::Equal => {},
                Ordering::Greater => {},
            }
        }
        let cur: T = get(read v.*, i).*;
        let big: T = get(read v.*, child).*;
        match cur.cmp(big) {
            Ordering::Less => {
                set(write v.*, i, big);
                set(write v.*, child, cur);
                i = child;
            },
            Ordering::Equal => {
                return;
            },
            Ordering::Greater => {
                return;
            },
        }
    }
}

pub fn sort_ord[T: Ord + copy](v: write Vec[T]) alloc -> unit {
    let n: usize = len(read v.*);
    if n < 2usize {
        return;
    }
    // Heapify: sift every internal node down, last parent first.
    let mut start: usize = n / 2usize;
    while start > 0usize {
        start = start - 1usize;
        sift_down_ord(write v.*, start, n);
    }
    // Repeatedly move the heap max into the growing sorted suffix.
    let mut end: usize = n;
    while end > 1usize {
        end = end - 1usize;
        let top: T = get(read v.*, 0usize).*;
        let last: T = get(read v.*, end).*;
        set(write v.*, 0usize, last);
        set(write v.*, end, top);
        sift_down_ord(write v.*, 0usize, end);
    }
}

// A comparator-driven heapsort: the SAME `Vec` sorts ascending or descending
// purely by which `less` comparator is passed (design: the order is
// comparator-driven, not hard-coded). `sift_down_by` is `sift_down_ord` with
// `less` in place of `Ord::cmp`.
fn sift_down_by[T: copy](v: write Vec[T], less: fn(read T, read T) -> bool, root: usize, end: usize) alloc -> unit {
    let mut i: usize = root;
    while i < end / 2usize {
        let left: usize = 2usize * i + 1usize;
        let mut child: usize = left;
        if left + 1usize < end {
            let l: T = get(read v.*, left).*;
            let r: T = get(read v.*, left + 1usize).*;
            if less(read l, read r) {
                child = left + 1usize;
            }
        }
        let cur: T = get(read v.*, i).*;
        let big: T = get(read v.*, child).*;
        if less(read cur, read big) {
            set(write v.*, i, big);
            set(write v.*, child, cur);
            i = child;
        } else {
            return;
        }
    }
}

pub fn sort[T: copy](v: write Vec[T], less: fn(read T, read T) -> bool) alloc -> unit {
    let n: usize = len(read v.*);
    if n < 2usize {
        return;
    }
    let mut start: usize = n / 2usize;
    while start > 0usize {
        start = start - 1usize;
        sift_down_by(write v.*, less, start, n);
    }
    let mut end: usize = n;
    while end > 1usize {
        end = end - 1usize;
        let top: T = get(read v.*, 0usize).*;
        let last: T = get(read v.*, end).*;
        set(write v.*, 0usize, last);
        set(write v.*, end, top);
        sift_down_by(write v.*, less, 0usize, end);
    }
}
