// Generic instantiated at two different array LENGTHS ([3]i64 and [2]i64):
// instance identity is length-sensitive (`same_len`), mirroring `mangle_ty`'s
// `arr3_i64` vs `arr2_i64` — the two must not collapse onto one instance.
fn idf[T: copy](x: T) -> T {
    return x;
}
fn main() -> i64 {
    let a: [3]i64 = [1, 2, 3];
    let b: [3]i64 = idf(a);
    let s: [2]i64 = [100, 200];
    let t: [2]i64 = idf(s);
    return b[2] + t[1];
}
