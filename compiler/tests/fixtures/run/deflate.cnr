    return t;
}

// zlib level 1 with a Z_FULL_FLUSH between two writes: a compressed block, an
// empty stored sync block, a second compressed block ("first block of data,
// second block of data").
fn v5_comp() -> [49]u8 {
    let t: [49]u8 = [
        0x4au8, 0xcbu8, 0x2cu8, 0x2au8, 0x2eu8, 0x51u8, 0x48u8, 0xcau8, 0xc9u8, 0x4fu8, 0xceu8, 0x56u8,
        0xc8u8, 0x4fu8, 0x53u8, 0x48u8, 0x49u8, 0x2cu8, 0x49u8, 0xd4u8, 0x51u8, 0x00u8, 0x00u8, 0x00u8,
        0x00u8, 0xffu8, 0xffu8, 0x2bu8, 0x4eu8, 0x4du8, 0xceu8, 0xcfu8, 0x4bu8, 0x51u8, 0x48u8, 0xcau8,
        0xc9u8, 0x4fu8, 0xceu8, 0x56u8, 0xc8u8, 0x4fu8, 0x53u8, 0x48u8, 0x49u8, 0x2cu8, 0x49u8, 0x04u8,
        0x00u8,
    ];
    return t;
}

// zlib level 9: a 4000-byte cycling-digit pattern (byte i = 48 + i % 10) —
// long matches at distance 10; the expected output is regenerated by a loop.
fn v6_comp() -> [36]u8 {
    let t: [36]u8 = [
        0xedu8, 0xc6u8, 0x49u8, 0x01u8, 0x00u8, 0x20u8, 0x08u8, 0x00u8, 0xb0u8, 0x4au8, 0x78u8, 0x20u8,
        0xdau8, 0xbfu8, 0x98u8, 0x31u8, 0xf8u8, 0x6cu8, 0xafu8, 0xc5u8, 0x98u8, 0x6bu8, 0xe7u8, 0xa9u8,
        0xfbu8, 0xc2u8, 0xccu8, 0xccu8, 0xccu8, 0xccu8, 0xccu8, 0xccu8, 0xccu8, 0x9au8, 0xf6u8, 0x01u8,
    ];
    return t;
}

// Reserved block type 11 (header bits 0,1,1).
fn c1_comp() -> [1]u8 {
    let t: [1]u8 = [
        0x06u8,
    ];
    return t;
}

// Stored block declaring LEN=10 with only 3 payload bytes present.
fn c3_comp() -> [8]u8 {
    let t: [8]u8 = [
        0x01u8, 0x0au8, 0x00u8, 0xf5u8, 0xffu8, 0x61u8, 0x62u8, 0x63u8,
    ];
    return t;
}

// Stored block whose NLEN (0x0000) is not LEN's (0x000a) complement.
fn c4_comp() -> [15]u8 {
    let t: [15]u8 = [
        0x01u8, 0x0au8, 0x00u8, 0x00u8, 0x00u8, 0x30u8, 0x31u8, 0x32u8, 0x33u8, 0x34u8, 0x35u8, 0x36u8,
        0x37u8, 0x38u8, 0x39u8,
    ];
    return t;
}

// v3_comp cut to its first 3 bytes: ends mid fixed-Huffman data.
fn c5_comp() -> [3]u8 {
    let t: [3]u8 = [
        0x4bu8, 0x4cu8, 0xa4u8,
    ];
    return t;
}

// Fixed block whose first code is literal/length symbol 286 (reserved).
fn c6_comp() -> [2]u8 {
    let t: [2]u8 = [
        0x1bu8, 0x03u8,
    ];
    return t;
}

// Fixed block: literal 'a', then a length-3 match at distance 2 — but only 1
// byte of output exists.
fn c7_comp() -> [4]u8 {
    let t: [4]u8 = [
        0x4bu8, 0x04u8, 0x42u8, 0x00u8,
    ];
    return t;
}

// Dynamic header declaring HLIT=30, i.e. 287 literal/length codes (max 286).
fn c8_comp() -> [3]u8 {
    let t: [3]u8 = [
        0xf5u8, 0x00u8, 0x00u8,
    ];
    return t;
}

// Dynamic block whose first code-length symbol is 16 (repeat) with no
// previous length to repeat.
fn c9_comp() -> [4]u8 {
    let t: [4]u8 = [
        0x05u8, 0x00u8, 0x02u8, 0x24u8,
    ];
    return t;
}

// Dynamic block whose code-length code is oversubscribed (three 1-bit codes).
fn c10_comp() -> [4]u8 {
    let t: [4]u8 = [
        0x05u8, 0x00u8, 0x92u8, 0x00u8,
    ];
    return t;
}

// v4_comp cut to its first 30 bytes: ends inside the dynamic code lengths.
fn c11_comp() -> [30]u8 {
    let t: [30]u8 = [
        0x4du8, 0x90u8, 0x5du8, 0x4eu8, 0xc4u8, 0x30u8, 0x0cu8, 0x84u8, 0xafu8, 0x32u8, 0x07u8, 0x58u8,
        0xf6u8, 0x00u8, 0xf0u8, 0x84u8, 0xf8u8, 0x91u8, 0x90u8, 0xe0u8, 0x05u8, 0xb8u8, 0x80u8, 0x9bu8,
        0x78u8, 0xdbu8, 0x68u8, 0x53u8, 0x67u8, 0xe5u8,
    ];
    return t;
}

// Fixed block: literal 'a', length-3 match, then distance symbol 30 (reserved).
fn c12_comp() -> [4]u8 {
    let t: [4]u8 = [
        0x4bu8, 0x04u8, 0x3eu8, 0x00u8,
    ];
    return t;
}

// ---- test harness -----------------------------------------------------------

fn chk(cond: bool) -> i64 {
    if cond {
        return 1;
    }
    return 0;
}

// Fold a decoded buffer into the running checksum (order-sensitive).
fn mix(h: write i64, v: read Vec[u8]) -> unit {
    let m: usize = len(read v);
    let mut i: usize = 0usize;
    while i < m {
        let b: i64 = conv i64 get(read v, i).*;
        wrapping {
            h.* = h.* * 31 + b;
        }
        i = i + 1usize;
    }
}

// Decode `comp` and require exactly the bytes of `expect`. One check.
fn check_vec(al: read Alloc, comp: [u8], expect: [u8], h: write i64) alloc -> i64 {
    let mut outv: Vec[u8] = vec_new(al);
    match inflate(comp, write outv) {
        IRes::Err(e) => {
            trace(0);
            return 0;
        }
        IRes::Ok(n) => {
            let m: usize = len(expect);
            let mut ok: bool = n == conv i64 m && len(read outv) == m;
            let mut i: usize = 0usize;
            while ok && i < m {
                if get(read outv, i).* != expect[i] {
                    ok = false;
                }
                i = i + 1usize;
            }
            mix(h, read outv);
            let c: i64 = chk(ok);
            trace(c);
            return c;
        }
    }
}

// Decode `comp` and require `n` bytes of the cycling-digit pattern
// (byte i = 48 + i % 10). One check.
fn check_pattern(al: read Alloc, comp: [u8], n: i64, h: write i64) alloc -> i64 {
    let mut outv: Vec[u8] = vec_new(al);
    match inflate(comp, write outv) {
        IRes::Err(e) => {
            trace(0);
            return 0;
        }
        IRes::Ok(g) => {
            let mut ok: bool = g == n && conv i64 len(read outv) == n;
            let mut i: i64 = 0;
            while ok && i < n {
                if conv i64 get(read outv, conv usize i).* != 48 + i % 10 {
                    ok = false;
                }
                i = i + 1;
            }
            mix(h, read outv);
            let c: i64 = chk(ok);
            trace(c);
            return c;
        }
    }
}

// Decode `comp` and require exactly the error code `code`. One check.
fn expect_derr(al: read Alloc, comp: [u8], code: i64) alloc -> i64 {
    let mut outv: Vec[u8] = vec_new(al);
    match inflate(comp, write outv) {
        IRes::Ok(n) => {
            trace(0);
            return 0;
        }
        IRes::Err(e) => {
            let c: i64 = chk(e.code == code);
            trace(c);
            return c;
        }
    }
}

fn main() alloc -> i64 {
    let mut st: FreeList = with_window(16777216usize, 4194304usize);
    let al: Alloc = mk_alloc(write st);
    let mut h: i64 = 17;
    let mut acc: i64 = 0;

    // ---- valid streams (1 check each) ----------------------------------------
    let a1: [48]u8 = v1_comp();
    acc = acc + check_vec(read al, slice_of(a1), b"The quick brown fox jumps over the lazy dog", write h);
    let a2: [12]u8 = v2_comp();
    acc = acc + check_vec(read al, slice_of(a2), b"Hello, hello, hello, hello!", write h);
    let a3: [6]u8 = v3_comp();
    acc = acc + check_vec(read al, slice_of(a3), b"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", write h);
    let a4: [323]u8 = v4_comp();
    acc = acc + check_vec(read al, slice_of(a4), b"Candor is a language laboratory: a reference compiler, a tree-walking oracle, a MIR interpreter, and two native backends that must all agree byte for byte on every observable. The DEFLATE decoder below reads bit streams produced by a real compressor and reconstructs the original bytes, block by block, symbol by symbol, match by match. Stored blocks pass bytes through untouched; fixed blocks use the standard code; dynamic blocks carry their own code lengths, compressed by the code length code with its run-length symbols sixteen, seventeen, eighteen.", write h);
    let a5: [49]u8 = v5_comp();
    acc = acc + check_vec(read al, slice_of(a5), b"first block of data, second block of data", write h);
    let a6: [36]u8 = v6_comp();
    acc = acc + check_pattern(read al, slice_of(a6), 4000, write h);

    // ---- malformed streams: exact error codes (1 check each) -----------------
    let b1: [1]u8 = c1_comp();
    acc = acc + expect_derr(read al, slice_of(b1), E_BTYPE);
    // Empty input: a zero-length view of a one-byte array.
    let z: [1]u8 = [0u8; 1];
    acc = acc + expect_derr(read al, subslice(slice_of(z), 0usize, 0usize), E_TRUNC);
    let b3: [8]u8 = c3_comp();
    acc = acc + expect_derr(read al, slice_of(b3), E_TRUNC);
    let b4: [15]u8 = c4_comp();
    acc = acc + expect_derr(read al, slice_of(b4), E_STORED);
    let b5: [3]u8 = c5_comp();
    acc = acc + expect_derr(read al, slice_of(b5), E_TRUNC);
    let b6: [2]u8 = c6_comp();
    acc = acc + expect_derr(read al, slice_of(b6), E_HUFF);
    let b7: [4]u8 = c7_comp();
    acc = acc + expect_derr(read al, slice_of(b7), E_DIST);
    let b8: [3]u8 = c8_comp();
    acc = acc + expect_derr(read al, slice_of(b8), E_META);
    let b9: [4]u8 = c9_comp();
    acc = acc + expect_derr(read al, slice_of(b9), E_META);
    let b10: [4]u8 = c10_comp();
    acc = acc + expect_derr(read al, slice_of(b10), E_META);
    let b11: [30]u8 = c11_comp();
    acc = acc + expect_derr(read al, slice_of(b11), E_TRUNC);
    let b12: [4]u8 = c12_comp();
    acc = acc + expect_derr(read al, slice_of(b12), E_HUFF);

    // The checksum over every decoded byte, compared across all engines.
    trace(h);
    return acc;
}
